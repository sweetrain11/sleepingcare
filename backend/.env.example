# ==============================================
# SleepingCare 환경변수 설정
# 이 파일을 .env로 복사 후 실제 값 입력
# ==============================================

# TimescaleDB (Docker)
DATABASE_URL=postgresql://postgres:password@localhost:5432/sleepingcare_db

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# MQTT 브로커 (Mosquitto)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# FastAPI 서버
APP_HOST=0.0.0.0
APP_PORT=8001
